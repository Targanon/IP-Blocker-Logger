<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:IP_Blocker_Logger.Services"
             x:Class="IP_Blocker_Logger.Pages.FirewallPage"
             Title="IP Blocker">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <Entry x:Name="IpEntry" Placeholder="IP (e.g. 8.8.8.8)" Grid.Column="0"/>
            <Button Text="Add" Clicked="OnAdd" Grid.Column="1"/>
        </Grid>

        <Button x:Name="StartStopButton" Text="Start IP Blocking" Clicked="OnToggleFirewall"/>

        <Label Text="Blocked IPs:" FontAttributes="Bold"/>

        <CollectionView x:Name="IpList" HeightRequest="180"
                        x:DataType="services:BlockedIpEntry">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:BlockedIpEntry">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="Red" CommandParameter="{Binding Address}" Invoked="OnDelete"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="8" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Address}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding Enabled}" Toggled="OnToggleSwitch"/>
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Recent Network Events:" FontAttributes="Bold"/>

        <CollectionView x:Name="LogList" HeightRequest="200"
                        x:DataType="services:FirewallLogEntry">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:FirewallLogEntry">
                    <Border Padding="8" Margin="2" BackgroundColor="LightGray" Stroke="Gray" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" FontSize="10" Text="{Binding TimestampUtc, StringFormat='{0:HH:mm:ss}'}" />
                                <Label Grid.Column="1" FontSize="10" Text="{Binding Protocol}" />
                            </Grid>
                            <Label FontSize="12" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SourceIp}" />
                                        <Span Text=" → " />
                                        <Span Text="{Binding DestIp}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="10">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Status: " />
                                        <Span Text="{Binding Blocked}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>