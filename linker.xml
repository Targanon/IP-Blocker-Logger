<?xml version="1.0" encoding="utf-8" ?>
<linker>
  <!-- Preserve all MAUI types explicitly -->
  <assembly fullname="Microsoft.Maui" preserve="all" />
  <assembly fullname="Microsoft.Maui.Controls" preserve="all" />
  <assembly fullname="Microsoft.Maui.Hosting" preserve="all" />
  <assembly fullname="Microsoft.Maui.Essentials" preserve="all" />
  
  <!-- Preserve the specific MauiApplication class that's causing issues -->
  <assembly fullname="Microsoft.Maui">
    <type fullname="Microsoft.Maui.MauiApplication" preserve="all" />
    <type fullname="Microsoft.Maui.Hosting.MauiApp" preserve="all" />
  </assembly>
  
  <!-- Preserve the main application assembly -->
  <assembly fullname="IP Blocker Logger" preserve="all" />
  
  <!-- Preserve Android VPN services -->
  <assembly fullname="Mono.Android">
    <type fullname="Android.Net.VpnService" preserve="all" />
    <type fullname="Android.App.Service" preserve="all" />
    <type fullname="Android.Content.Context" preserve="all" />
    <type fullname="Android.App.Application" preserve="all" />
  </assembly>
  
  <!-- Preserve System assemblies that might be trimmed -->
  <assembly fullname="System.Private.CoreLib" preserve="all" />
  <assembly fullname="System.Runtime" preserve="all" />
</linker>